#!/bin/bash
# Post-install: symlink easyenclave as PID 1 + its multicall applets,
# set up dirs. No kernel or modules in the rootfs — kernel lives in
# the UKI, and easyenclave doesn't load modules post-boot.
set -euo pipefail

# easyenclave as PID 1
ln -sf /usr/local/bin/easyenclave /sbin/init

# Multicall applets (busybox-style, no busybox): the easyenclave binary
# dispatches on argv[0], so symlinking it as `sh`/`httpd` gives the rootfs a
# minimal shell + static file server. /usr/local/bin is earliest in PATH.
# Networking that the old initrd shell needed (ip/udhcpc/findfs/mount) is now
# done by ee-init before switch_root, so the rootfs no longer needs them.
mkdir -p /usr/local/bin
ln -sf /usr/local/bin/easyenclave /bin/sh
ln -sf /usr/local/bin/easyenclave /usr/local/bin/httpd

# Required dirs
mkdir -p /etc/easyenclave /var/lib/easyenclave /mnt/config

# Rootfs is mounted read-only at runtime, but udhcpc's DNS hook and
# the EE_DNS static override both need to write resolv.conf. Point
# /etc/resolv.conf at /run/resolv.conf (tmpfs, mounted by init before
# udhcpc runs) so writes land on tmpfs.
ln -sf /run/resolv.conf /etc/resolv.conf

echo "[mkosi.postinst] Done."
